# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next.rollback*/
/.next-staged/
# Side-build dist dirs (SJC_DIST_DIR). Must stay ignored: Tailwind's scanner
# skips gitignored paths, and an unignored dist dir gets its binary Turbopack
# cache scanned — stray bytes parse as a class name and emit invalid CSS, which
# 500s every page through globals.css.
/.next-preview*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# user file uploads (/files) — real blobs stored on the server, not in git
/uploads/

# AI-generated email drafts — client content, kept on the server, not in git
/drafts/

# Inbox-ops agent run checkpoints — client content, kept on the server, not in git
/reports/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# import rollback snapshots (runtime artifacts)
db/.import-snapshot.json
db/.subs-import-snapshot.json
db/.subs-csv-import-snapshot.json
db/.cents-snapshot.json
.next-preview/

# session scratch (audit scripts, one-off runs)
tmp/
