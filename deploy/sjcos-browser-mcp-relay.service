[Unit]
Description=SJC OS authenticated MCP kernel peer relay
Requires=sjcos-browser.service
After=sjcos-browser.service
ConditionPathExists=/etc/sjcos-browser/phase1-accepted
[Service]
User=root
Slice=user-@JOE_UID@-sjcosbrowser.slice
ExecStart=/usr/bin/node --max-old-space-size=16 /opt/sjcos-browser/node/source/scripts/sjcos-browser.mjs --mcp-peer-relay
LoadCredential=peer-key:/etc/sjcos-browser/credentials/peer-key
Restart=no
MemoryMax=64M
MemorySwapMax=0
CPUQuota=5%
TasksMax=8
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/run/sjcos-browser
InaccessiblePaths=/etc/sjcos-browser/credentials
RestrictAddressFamilies=AF_UNIX
KillMode=control-group
TimeoutStopSec=15
LimitCORE=0
