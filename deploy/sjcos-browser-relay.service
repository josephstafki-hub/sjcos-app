# REVIEW TEMPLATE ONLY. Root owns public sockets; Node/Chromium remain nonroot.
[Unit]
Description=SJC OS fixed browser peer relay
Requires=sjcos-browser.service
After=sjcos-browser.service
ConditionPathExists=/etc/sjcos-browser/phase1-accepted
[Service]
User=root
Slice=user-@JOE_UID@-sjcosbrowser.slice
ExecStart=/usr/bin/python3 -I -B /opt/sjcos-browser/node/source/deploy/browser/production-relay.py
Restart=no
MemoryMax=32M
MemorySwapMax=0
CPUQuota=10%
TasksMax=8
RuntimeDirectory=sjcos-browser
RuntimeDirectoryMode=0755
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/run/sjcos-browser
KillMode=control-group
TimeoutStopSec=15
