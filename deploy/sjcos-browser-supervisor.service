# REVIEW TEMPLATE ONLY. Requires reviewed fixed bridge/adapters, not installed.
[Unit]
Description=SJC OS serialized browser admission and persistent latch
ConditionPathExists=/etc/sjcos-browser/phase1-accepted
[Service]
Type=simple
User=root
Group=sjcos-browser
Slice=user-@JOE_UID@-sjcosbrowsersupervisor.slice
ExecStart=/usr/bin/python3 -I -B /opt/sjcos-browser/node/source/deploy/browser/supervisor-entry.py
Restart=on-failure
RestartSec=5
MemoryMax=32M
MemorySwapMax=0
CPUQuota=10%
TasksMax=16
RuntimeDirectory=sjcos-browser-supervisor
RuntimeDirectoryMode=0750
StateDirectory=sjcos-browser-supervisor
StateDirectoryMode=0700
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/run/sjcos-browser-supervisor /var/lib/sjcos-browser-supervisor
KillMode=control-group
TimeoutStopSec=15
