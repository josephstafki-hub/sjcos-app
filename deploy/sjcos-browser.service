# REVIEW TEMPLATE ONLY. Not installed/started; @JOE_UID@ must be substituted.
[Unit]
Description=SJC OS attended public browser controller
Requires=sjcos-browser-supervisor.service sjcos-browser-gate.service sjcos-browser-dns.service
After=sjcos-browser-supervisor.service sjcos-browser-gate.service sjcos-browser-dns.service
ConditionPathExists=/etc/sjcos-browser/phase1-accepted
[Service]
Type=simple
User=sjcos-browser
Group=sjcos-browser
Slice=user-@JOE_UID@-sjcosbrowser.slice
NetworkNamespacePath=/run/netns/sjcos-browser
ExecStartPre=+/usr/bin/python3 -I -B /opt/sjcos-browser/node/source/deploy/browser/browser-latch.py check
ExecStart=/usr/bin/node --max-old-space-size=256 /opt/sjcos-browser/node/source/scripts/sjcos-browser.mjs
ExecStopPost=+/usr/bin/python3 -I -B /opt/sjcos-browser/node/source/deploy/browser/browser-latch.py record
Restart=no
Nice=15
OOMPolicy=stop
KillMode=control-group
TimeoutStopSec=15
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RuntimeDirectory=sjcos-browser-runtime
RuntimeDirectoryMode=0750
ReadWritePaths=/run/sjcos-browser-runtime
TemporaryFileSystem=/run/sjcos-browser-runtime/tmp:rw,nosuid,nodev,noexec,size=384M,mode=0700
TemporaryFileSystem=/dev/shm:rw,nosuid,nodev,noexec,size=128M
BindReadOnlyPaths=/run/postgresql/.s.PGSQL.@BROWSER_DB_PORT@
LoadCredential=database:/etc/sjcos-browser/credentials/browser-database
LoadCredential=web-rpc:/etc/sjcos-browser/credentials/web-rpc
LoadCredential=frame:/etc/sjcos-browser/credentials/frame
LoadCredential=read-dispatch:/etc/sjcos-browser/credentials/read-dispatch
LoadCredential=manifest-hmac:/etc/sjcos-browser/credentials/manifest-hmac
LoadCredential=audit:/etc/sjcos-browser/credentials/audit
# Credential files are controller-only; Chromium and CLI get explicit env and no
# inherited descriptors/mount access. Public CA only; gate owns CA private key.
