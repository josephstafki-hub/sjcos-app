[Unit]
Description=SJC OS — MCP Streamable HTTP transport (bearer-gated)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/sjcos-app
# MCP_HTTP_PORT lives HERE, not in .env.local — the server reads it from
# process.env only, so plain stdio spawns (the `claude mcp` registration) never
# see it and never fight this service for the port. Setting it is what switches
# the server from stdio into HTTP mode; the bearer token (MCP_HTTP_TOKEN) is
# still read from sjcos-app/.env.local, and it refuses to start without one.
Environment=MCP_HTTP_PORT=3018
# env-resolved node, NOT a hardcoded binary path: the Aug 3–15 2026 outage was a
# 12-day 203/EXEC crash-loop from a stale /usr/local/bin/node that no longer
# existed after a node upgrade. /usr/bin/env follows PATH to wherever node
# currently lives. The sjcos-mcp-watchdog timer (curl /healthz every 5 min)
# backstops anything Restart= can't recover.
ExecStart=/usr/bin/env node %h/sjcos-app/mcp/sjcos-mcp.mjs
Restart=on-failure
RestartSec=30
NoNewPrivileges=true

[Install]
WantedBy=default.target
